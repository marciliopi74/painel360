generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------

enum Papel {
  gestor_local
  secretario
  coordenador
  profissional
}

enum TipoEquipe {
  ESF
  EAP
  EMULTI
  ESB
}

enum TipoEquipeAlvo {
  ESF_EAP
  ESB
  EMULTI
}

enum CategoriaIndicador {
  boa_pratica_pontuada
  indicador_proporcional
  indicador_media
}

enum UnidadeMedida {
  percentual
  media
}

enum Polaridade {
  maior_melhor
  menor_melhor
  neutra
}

enum Quadrimestre {
  Q1
  Q2
  Q3
}

enum Classificacao {
  otimo
  bom
  suficiente
  regular
}

enum TipoSincronizacao {
  manual
  automatica
}

enum StatusSincronizacao {
  em_andamento
  concluida
  erro
  parcial
}

enum TipoRelatorio {
  diario
  semanal
  quadrimestral
}

// -------------------- USUARIOS E AUTENTICACAO --------------------

model Usuario {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome           String
  email          String        @unique
  senhaHash      String        @map("senha_hash")
  telefone       String
  papel          Papel
  profissionalId String?       @map("profissional_id") @db.Uuid
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  ativo          Boolean       @default(true)
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)

  sincronizacoes Sincronizacao[]

  @@map("usuarios")
}

// -------------------- EQUIPES E PROFISSIONAIS --------------------

model Equipe {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                String
  tipo                TipoEquipe
  ine                 String?
  equipeReferenciaId  String?    @map("equipe_referencia_id") @db.Uuid
  equipeReferencia    Equipe?    @relation("EquipeReferencia", fields: [equipeReferenciaId], references: [id])
  equipesVinculadas   Equipe[]   @relation("EquipeReferencia")
  ativo               Boolean    @default(true)
  // chave natural da linha de origem no e-SUS (co_seq_equipe), usada para upsert idempotente
  // pela sincronização via FDW — ine sozinho não é confiável (equipes eMulti repetem o mesmo ine).
  fonteId             BigInt?    @unique @map("fonte_id")
  // carga horária semanal — usada pelas regras de vinculação eSB↔eSF/eAP dos indicadores
  // B1-B6 (ex.: 2 eSB 20h dividem a população de 1 eSF 40h). Não vem do e-SUS de forma
  // confiável; preenchida manualmente pelo coordenador junto com equipeReferenciaId.
  cargaHorariaSemanal Int?       @map("carga_horaria_semanal")

  profissionais               Profissional[]
  cadastrosIndividuais        CadastroIndividual[]
  cadastrosDomiciliares       CadastroDomiciliar[]
  atendimentos                Atendimento[]
  resultadosIndicadores       ResultadoIndicador[]
  boasPraticasPontuacaoPessoa BoaPraticaPontuacaoPessoa[]
  satisfacoes                 SatisfacaoEquipe[]
  resultadosVinculoAcompanhamento ResultadoVinculoAcompanhamento[]

  @@map("equipes")
}

model Profissional {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipeId String  @map("equipe_id") @db.Uuid
  equipe   Equipe  @relation(fields: [equipeId], references: [id])
  nome     String
  cns      String
  cbo      String
  ehAcs    Boolean @default(false) @map("eh_acs")
  ativo    Boolean @default(true)
  fonteId  BigInt? @unique @map("fonte_id")

  usuarios              Usuario[]
  cadastrosIndividuais  CadastroIndividual[]
  cadastrosDomiciliares CadastroDomiciliar[]
  atendimentos          Atendimento[]

  @@map("profissionais")
}

// -------------------- DADOS OPERACIONAIS --------------------

model CadastroIndividual {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profissionalId String       @map("profissional_id") @db.Uuid
  profissional   Profissional @relation(fields: [profissionalId], references: [id])
  equipeId       String       @map("equipe_id") @db.Uuid
  equipe         Equipe       @relation(fields: [equipeId], references: [id])
  // ATENÇÃO: vem de tb_cds_cad_individual.nu_cns_cidadao, que nesta instalação costuma ser um
  // hash de 32 caracteres, NÃO o CNS real de 15 dígitos de tb_cidadao.nu_cns/cidadaos_vinculados_
  // equipe() (ver docs/esus-fdw.md). Os dois espaços de identificador NÃO são joináveis entre si
  // — não usar este campo para cruzar com boas_praticas_pontuacao_pessoa.cidadao_cns ou qualquer
  // dado que venha de cidadaos_vinculados_equipe()/tb_cidadao (esses usam o CNS real).
  // NULLABLE desde 2026-09-14: um cadastro individual pode existir no e-SUS sem CNS ainda (só
  // CPF) — ver `cidadaoCpf` abaixo. A sincronização passou a importar esses casos também (antes
  // ficavam completamente de fora do painel, bug real reportado pelo usuário).
  cidadaoCns     String?      @map("cidadao_cns")
  // CPF do cidadão (tb_cds_cad_individual.nu_cpf_cidadao) — usado como identificador alternativo
  // (busca, link para /cidadao/[x], exibição) quando cidadaoCns é NULL. Também pode coexistir com
  // um cidadaoCns preenchido.
  cidadaoCpf     String?      @map("cidadao_cpf")
  // DNV (Declaração de Nascido Vivo, tb_cds_cad_individual.nu_dnv_cidadao) — identificador usado
  // pelo e-SUS pra recém-nascidos cadastrados antes de terem CPF ou CNS. Mesmo tratamento de
  // cidadaoCpf: alternativa quando os outros dois são NULL (ver src/lib/ui/identificadorCidadao.ts
  // pra ordem de prioridade CNS > CPF > DNV usada em toda exibição/navegação).
  cidadaoDnv     String?      @map("cidadao_dnv")
  // CNS REAL do cidadão (tb_cidadao.nu_cns), resolvido via tb_cds_cad_individual.co_unico_ficha
  // == tb_cidadao.co_unico_ultima_ficha — o GUID interno do e-SUS que identifica qual ficha
  // atualizou por último aquele registro de cidadão. Isso NÃO é o mesmo join (impossível) por
  // igualdade de CNS descrito acima — é uma chave exata, não uma heurística por nome. Fica NULL
  // quando o cidadão não tem CNS real ainda (CADSUS pendente) ou quando uma ficha mais recente
  // que não é este cadastro individual foi a última a tocar o registro em tb_cidadao (join não
  // bate, tratado como "identidade não resolvida", nunca como match errado). Único uso: cruzar
  // com boas_praticas_pontuacao_pessoa.cidadao_cns (ver /cidadao/[cns]).
  cidadaoCnsReal String?      @map("cidadao_cns_real")
  // nome do cidadão (prioriza nome social) — vem de tb_cidadao via join por nu_cns na
  // sincronização; pode ser nulo em registros sincronizados antes desta coluna existir, até a
  // próxima sincronização atualizá-los.
  cidadaoNome    String?      @map("cidadao_nome")
  dataCadastro   DateTime     @map("data_cadastro") @db.Date
  temErro        Boolean      @default(false) @map("tem_erro")
  tipoErro       String?      @map("tipo_erro")
  // "Fora de área (FA)" — Nota Técnica 30, item 3.4.b: exclui a pessoa da Dimensão Cadastro.
  // Sincronizado direto de esus.tb_cds_cad_individual.st_fora_area (flag real do e-SUS).
  foraDeArea     Boolean      @default(false) @map("fora_de_area")
  atualizadoEm   DateTime     @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  fonteId        BigInt?      @unique @map("fonte_id")

  @@map("cadastros_individuais")
}

model CadastroDomiciliar {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profissionalId     String       @map("profissional_id") @db.Uuid
  profissional       Profissional @relation(fields: [profissionalId], references: [id])
  equipeId           String       @map("equipe_id") @db.Uuid
  equipe             Equipe       @relation(fields: [equipeId], references: [id])
  enderecoReferencia String       @map("endereco_referencia")
  dataCadastro       DateTime     @map("data_cadastro") @db.Date
  temErro            Boolean      @default(false) @map("tem_erro")
  tipoErro           String?      @map("tipo_erro")
  atualizadoEm       DateTime     @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  fonteId            BigInt?      @unique @map("fonte_id")

  @@map("cadastros_domiciliares")
}

model Atendimento {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Nullable: o fato do e-SUS usado para sincronizar atendimentos (tb_fat_atendimento_individual)
  // resolve equipe/CBO com 100% de confiabilidade, mas não o profissional individual — ver
  // docs/esus-fdw.md. Mantido obrigatório para atendimentos lançados manualmente na aplicação.
  profissionalId  String?       @map("profissional_id") @db.Uuid
  profissional    Profissional? @relation(fields: [profissionalId], references: [id])
  equipeId        String        @map("equipe_id") @db.Uuid
  equipe          Equipe        @relation(fields: [equipeId], references: [id])
  dataAtendimento DateTime      @map("data_atendimento") @db.Date
  tipoAtendimento String        @map("tipo_atendimento")
  // CBO (6 dígitos, sem pontuação) do profissional executante — resolvido a partir do fato do
  // e-SUS (tb_dim_cbo.nu_cbo, 100% confiável) e usado pelo motor de cálculo de C1-C7 para
  // filtrar por CBO elegível conforme cada Nota Metodológica (ver docs/indicadores-qualidade.md).
  cbo             String?
  temErro         Boolean       @default(false) @map("tem_erro")
  tipoErro        String?       @map("tipo_erro")
  atualizadoEm    DateTime      @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  fonteId         BigInt?       @unique @map("fonte_id")

  @@map("atendimentos")
}

// -------------------- INDICADORES DE QUALIDADE --------------------

model IndicadorCatalogo {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo                 String             @unique
  nome                   String
  tipoEquipeAlvo         TipoEquipeAlvo     @map("tipo_equipe_alvo")
  categoria              CategoriaIndicador
  unidadeMedida          UnidadeMedida      @map("unidade_medida")
  polaridade             Polaridade
  parametroOtimoMin      Decimal?           @map("parametro_otimo_min")
  parametroOtimoMax      Decimal?           @map("parametro_otimo_max")
  parametroBomMin        Decimal?           @map("parametro_bom_min")
  parametroBomMax        Decimal?           @map("parametro_bom_max")
  parametroSuficienteMin Decimal?           @map("parametro_suficiente_min")
  parametroSuficienteMax Decimal?           @map("parametro_suficiente_max")
  // Fórmula de Cálculo, no formato padronizado das Notas Metodológicas oficiais — descrição
  // textual do que é contado (não o numerador/denominador numérico de um resultado específico,
  // que fica em ResultadoIndicador). Preenchido a partir da lógica já implementada em
  // sql/04, 08, 09 e 10 (que por sua vez reflete as Notas oficiais lidas nesta sessão).
  formulaNumerador       String?            @map("formula_numerador")
  formulaDenominador     String?            @map("formula_denominador")
  anoReferencia          Int                @map("ano_referencia")

  criterios        BoaPraticaCriterio[]
  resultados       ResultadoIndicador[]
  pontuacoesPessoa BoaPraticaPontuacaoPessoa[]

  @@map("indicadores_catalogo")
}

model BoaPraticaCriterio {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  indicadorId      String            @map("indicador_id") @db.Uuid
  indicador        IndicadorCatalogo @relation(fields: [indicadorId], references: [id])
  codigoCriterio   String            @map("codigo_criterio")
  descricao        String
  pontos           Decimal
  janelaTempoMeses Int?              @map("janela_tempo_meses")

  pontuacoesPessoa BoaPraticaPontuacaoPessoa[]

  @@unique([indicadorId, codigoCriterio])
  @@map("boas_praticas_criterios")
}

model ResultadoIndicador {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipeId       String            @map("equipe_id") @db.Uuid
  equipe         Equipe            @relation(fields: [equipeId], references: [id])
  indicadorId    String            @map("indicador_id") @db.Uuid
  indicador      IndicadorCatalogo @relation(fields: [indicadorId], references: [id])
  quadrimestre   Quadrimestre
  ano            Int
  numerador      Decimal
  denominador    Decimal
  valorCalculado Decimal           @map("valor_calculado")
  classificacao  Classificacao
  calculadoEm    DateTime          @default(now()) @map("calculado_em") @db.Timestamptz(6)

  @@unique([equipeId, indicadorId, quadrimestre, ano])
  @@map("resultados_indicadores")
}

model BoaPraticaPontuacaoPessoa {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipeId     String             @map("equipe_id") @db.Uuid
  equipe       Equipe             @relation(fields: [equipeId], references: [id])
  indicadorId  String             @map("indicador_id") @db.Uuid
  indicador    IndicadorCatalogo  @relation(fields: [indicadorId], references: [id])
  cidadaoCns   String             @map("cidadao_cns")
  criterioId   String             @map("criterio_id") @db.Uuid
  criterio     BoaPraticaCriterio @relation(fields: [criterioId], references: [id])
  atingiu      Boolean
  quadrimestre Quadrimestre
  ano          Int

  @@map("boas_praticas_pontuacao_pessoa")
}

// -------------------- RELATORIOS --------------------

model RelatorioGerado {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo              TipoRelatorio
  periodoReferencia String        @map("periodo_referencia")
  arquivoUrl        String?       @map("arquivo_url")
  geradoEm          DateTime      @default(now()) @map("gerado_em") @db.Timestamptz(6)

  @@map("relatorios_gerados")
}

// -------------------- SINCRONIZACAO MANUAL --------------------

model Sincronizacao {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disparadaPor  String              @map("disparada_por") @db.Uuid
  usuario       Usuario             @relation(fields: [disparadaPor], references: [id])
  tipo          TipoSincronizacao
  status        StatusSincronizacao
  etapaAtual    String?             @map("etapa_atual")
  totalEstimado Int?                @map("total_estimado")
  processados   Int                 @default(0)
  iniciadoEm    DateTime            @default(now()) @map("iniciado_em") @db.Timestamptz(6)
  concluidoEm   DateTime?           @map("concluido_em") @db.Timestamptz(6)
  erroMensagem  String?             @map("erro_mensagem")

  @@map("sincronizacoes")
}

// -------------------- VÍNCULO E ACOMPANHAMENTO TERRITORIAL --------------------
// Componente de financiamento descrito na Nota Técnica nº 30/2025-CGESCO/DESCO/SAPS/MS —
// metodologia diferente dos indicadores de qualidade C1-C7/B1-B6/M1-M2 (não usa
// IndicadorCatalogo/ResultadoIndicador: tem 2 dimensões com pesos próprios, parâmetro por porte
// populacional do município, e dados externos ao e-SUS que precisam ser preenchidos
// manualmente — ver ConfiguracaoSistema e SatisfacaoEquipe abaixo).

// Beneficiário Bolsa Família/BPC (Nota Técnica 30, item 2.2.a e Passo 2 da Dimensão
// Acompanhamento) — dado do CadÚnico, sistema federal sem integração com esta instalação;
// preenchido manualmente. Chaveado pelo CNS REAL (tb_cidadao.nu_cns / cidadaos_vinculados_
// equipe()), de propósito — NÃO pelo cidadao_cns de CadastroIndividual, que nesta instalação é
// um hash não joinável com o CNS real (ver comentário em CadastroIndividual acima). Sem essa
// distinção o cálculo da Dimensão Acompanhamento nunca encontraria nenhum beneficiário.
model BeneficiarioVulneravel {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cidadaoCns   String   @unique @map("cidadao_cns")
  cidadaoNome  String?  @map("cidadao_nome")
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("beneficiarios_vulneraveis")
}

// Singleton (sempre id=1) — só guarda a população do município (IBGE), usada exclusivamente
// para achar a faixa de porte populacional do Anexo da Portaria SAPS/MS nº 161/2024 (parâmetro
// de pessoas vinculadas por equipe). Não vem do e-SUS.
model ConfiguracaoSistema {
  id                 Int      @id @default(1)
  populacaoMunicipio Int?     @map("populacao_municipio")
  atualizadoEm       DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@map("configuracao_sistema")
}

// % de atendimentos avaliados pelo usuário no app "Meu SUS Digital" no quadrimestre — usado só
// para o bônus da Dimensão Acompanhamento (item 3.13 da Nota Técnica 30). Não vem do e-SUS (é
// dado do app federal do cidadão, sem integração com esta instalação) — preenchido manualmente
// pelo coordenador por equipe/quadrimestre.
model SatisfacaoEquipe {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipeId             String       @map("equipe_id") @db.Uuid
  equipe               Equipe       @relation(fields: [equipeId], references: [id])
  quadrimestre         Quadrimestre
  ano                  Int
  percentualAvaliacoes Decimal      @map("percentual_avaliacoes")
  atualizadoEm         DateTime     @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  @@unique([equipeId, quadrimestre, ano])
  @@map("satisfacao_equipe")
}

model ResultadoVinculoAcompanhamento {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipeId String @map("equipe_id") @db.Uuid
  equipe   Equipe @relation(fields: [equipeId], references: [id])

  quadrimestre Quadrimestre
  ano          Int

  // Dimensão Cadastro (30% do escore final, até 3,00 pontos — Passos 1-3, itens 3.4-3.7)
  pessoasCadastroValido   Int           @map("pessoas_cadastro_valido")
  indicePonderadoCadastro Decimal       @map("indice_ponderado_cadastro")
  parametroPorte          Int           @map("parametro_porte")
  resultadoCadastro       Decimal       @map("resultado_cadastro")
  escoreCadastro          Decimal       @map("escore_cadastro")
  classificacaoCadastro   Classificacao @map("classificacao_cadastro")

  // Dimensão Acompanhamento (70% do escore final, até 7,00 pontos + bônus — Passos 1-4, item 3.13)
  acompanhadosSemCriterio       Int           @map("acompanhados_sem_criterio")
  acompanhadosIdosoOuCrianca    Int           @map("acompanhados_idoso_ou_crianca")
  acompanhadosBpcPbf            Int           @map("acompanhados_bpc_pbf")
  acompanhadosIdosoCriancaBpcPbf Int          @map("acompanhados_idoso_crianca_bpc_pbf")
  indicePonderadoAcompanhamento Decimal       @map("indice_ponderado_acompanhamento")
  resultadoAcompanhamento       Decimal       @map("resultado_acompanhamento")
  escoreAcompanhamentoBase      Decimal       @map("escore_acompanhamento_base")
  bonusSatisfacao               Decimal       @map("bonus_satisfacao")
  escoreAcompanhamento          Decimal       @map("escore_acompanhamento")
  classificacaoAcompanhamento   Classificacao @map("classificacao_acompanhamento")

  // Resultado final (item 3.14)
  escoreFinal        Decimal       @map("escore_final")
  classificacaoFinal Classificacao @map("classificacao_final")

  calculadoEm DateTime @default(now()) @map("calculado_em") @db.Timestamptz(6)

  @@unique([equipeId, quadrimestre, ano])
  @@map("resultados_vinculo_acompanhamento")
}
